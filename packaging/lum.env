# /etc/lum/lum.env — restart lum.service after changing settings.
# For CPU-only validation set LUM_DEVICE=task (see INSTALL.md for GPU groups).
LUM_DEVICE=amdgpu
LUM_POOL_BACKING=fixed
# LUM_ADMIN_PORT applies only when admin.port is unset.
# Host defaults to 127.0.0.1; configure trusted LAN access with lum config.
LUM_ADMIN_PORT=9390
# Default: automatically install and verify the supported Loom version under
# /opt/lum/runtimes for the system service. Optional external override (must be service-readable):
# LUM_RUNTIME_BIN=/opt/lum/runtime/bin

# Optional admin OIDC. Configure all required variables before restarting.
# LUM_OIDC_ENABLED=true
# LUM_OIDC_ISSUER=https://id.example.org/realms/home
# LUM_OIDC_ORIGIN=https://lum.example.org
# LUM_OIDC_CLIENT_ID=lum
# LUM_OIDC_ALLOWED_SUBJECTS=first-admin-sub,second-admin-sub
# Confidential clients only (path, not the secret itself):
# LUM_OIDC_CLIENT_SECRET_FILE=/etc/lum/oidc-secret
