{
  "name": "lum-ui",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build"
  },
  "prettier": {
    "printWidth": 100,
    "htmlWhitespaceSensitivity": "ignore",
    "plugins": [
      "prettier-plugin-svelte"
    ],
    "overrides": [
      {
        "files": "*.svelte",
        "options": {
          "parser": "svelte"
        }
      }
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/markdown-it": "^14.2.0",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "5.59.1",
    "svelte-check": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "7.3.8"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.3"
  }
}
